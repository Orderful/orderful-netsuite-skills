  <isinactive>F</isinactive>
  <name>Orderful | Render Packing Slip</name>
  <notifyadmins>F</notifyadmins>
  <notifyowner>T</notifyowner>
  <scriptfile>[/SuiteScripts/orderful-packing-slip/orderful_renderPackingSlip_RL.js]</scriptfile>
  <scriptdeployments>
    <scriptdeployment scriptid="customdeploy_orderful_render_packslip_rl">
      <allemployees>F</allemployees>
      <allpartners>F</allpartners>
